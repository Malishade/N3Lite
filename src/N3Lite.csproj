<Project Sdk="Microsoft.NET.Sdk">
  <!-- The same sources Unity compiles through package/Runtime/N3Lite.asmdef, built for .NET (the server). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- Unity 6 compiles C# 9; keep the two builds on the same language. -->
    <LangVersion>9.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <RootNamespace>LostEden.Vehicles</RootNamespace>
    <AssemblyName>N3Lite</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\package\Runtime\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
