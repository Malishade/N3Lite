<Project Sdk="Microsoft.NET.Sdk">
  <!-- The same sources Unity compiles through package/Runtime/N3Lite.asmdef, built for .NET. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <!-- Unity 6 compiles C# 9; keep the two builds on the same language. -->
    <LangVersion>9.0</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <RootNamespace>N3Lite</RootNamespace>
    <AssemblyName>N3Lite</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <!-- NuGet. CI publishes 0.1.<build number>; raise VersionPrefix by hand for a minor or major bump. -->
  <PropertyGroup>
    <PackageId>N3Lite</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Description>Vehicle simulation and collision in plain C#: characters, NPCs and cameras on one sub-stepped integrator, against heightmap terrain and triangle-mesh geometry.</Description>
    <PackageTags>physics;collision;character-controller;vehicle;heightmap;bvh</PackageTags>
    <RepositoryUrl>https://github.com/Malishade/N3Lite</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Malishade/N3Lite</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\package\Runtime\**\*.cs" Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
